# Slack ─ create at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me

# LLM provider (Groq is free; OpenAI/Anthropic also supported by Pydantic AI)
GROQ_API_KEY=gsk_replace_me
LLM_MODEL=groq:llama-3.3-70b-versatile

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=coding-task-queue

# GitHub (optional ─ if unset, a deterministic mock implementation is used)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=octocat/Hello-World
USE_GITHUB_MOCK=true

# Observability / runtime
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
ENVIRONMENT=local